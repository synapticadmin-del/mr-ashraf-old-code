    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.13.6",
    "expo": "~52.0.0",
    "expo-av": "~15.0.1",
    "expo-build-properties": "~0.13.1",
    "expo-constants": "~17.0.2",
    "expo-dev-client": "~5.0.0-preview.9",
    "expo-font": "~13.0.1",
